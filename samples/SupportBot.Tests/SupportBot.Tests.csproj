<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A sample: a support agent that calls a model through IChatClient, and two TokenLedger scenarios for it.
    The tests run with `dotnet run` and no test framework, so they work anywhere; with xUnit or NUnit the
    scenario code is the same. The recordings and baselines under tokenledger/ are committed: CI replays them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TokenLedger\TokenLedger.csproj" />
  </ItemGroup>

</Project>
