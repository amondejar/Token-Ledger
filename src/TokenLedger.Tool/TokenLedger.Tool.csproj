<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet-tokenledger: compares the TokenLedger baselines of two git refs and reports what changed in cost and
    behavior; creates pricing.json. Installed as a .NET tool: `dotnet tokenledger diff main`.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-tokenledger</ToolCommandName>
    <PackageId>TokenLedger.Tool</PackageId>
    <RollForward>Major</RollForward>
    <Description>dotnet tokenledger: compares the TokenLedger baselines of two git refs and lists, per scenario, the regressions, behavior changes and improvements in model calls, tokens, tools and estimated cost, as text, Markdown (for pull request comments) or JSON. Also creates pricing.json from the models your scenarios use, and summarizes what the whole suite costs.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;diff;pull-request</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenLedger\TokenLedger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="TokenLedger.Tests" />
  </ItemGroup>

</Project>
