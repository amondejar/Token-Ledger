<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>TokenLedger.AspNetCore</PackageId>
    <RootNamespace>TokenLedger.AspNetCore</RootNamespace>
    <Description>TokenLedger for ASP.NET Core integration tests: attributes each model call to the HTTP endpoint that made it (POST api/support/chat makes 3 calls), so baselines and pull request reports show the cost per endpoint, and connects the requests of a test to its scenario with WebApplicationFactory, TestServer or a real host.</Description>
    <PackageTags>$(PackageTags);aspnetcore;integration-tests;webapplicationfactory</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenLedger\TokenLedger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="TokenLedger.Tests" />
  </ItemGroup>

</Project>
