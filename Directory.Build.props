<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Package metadata shared by every packable project -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>TokenLedger contributors</Authors>
    <Copyright>Copyright (c) TokenLedger contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai;llm;tokens;cost;testing;snapshot;record-replay;microsoft-extensions-ai;ichatclient</PackageTags>
    <PackageProjectUrl>https://github.com/amondejar/Token-Ledger</PackageProjectUrl>
    <RepositoryUrl>https://github.com/amondejar/Token-Ledger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Builds on GitHub Actions are deterministic, so the packages on nuget.org are reproducible. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
